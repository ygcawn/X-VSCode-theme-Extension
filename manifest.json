{
  "manifest_version": 3,
  "name": "X VSCode Theme",
  "version": "2.0.0",
  "description": "Make X look like VS Code / Visual Studio style IDE",
  "permissions": ["storage"],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": ["content.js"],
      "css": ["theme.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Toggle IDE Mode"
  }
}